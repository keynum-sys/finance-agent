# LLM 配置（开发期建议用便宜模型，评测期换强模型）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o

# 数据缓存目录
DATA_DIR=./data_cache

# 向量库
CHROMA_DIR=./chroma_store

# Langfuse 可观测性（第10周再启用）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
